  "title": {
    "en": "Fair Price Check",
    "ko": "정상가 확인"
  },
  "subtitle": {
    "en": "Check a usual reference range before deciding what a price means.",
    "ko": "가격이 어떤 수준인지 판단하기 전에 통상적인 참고 범위를 확인하세요."
  },
  "disclaimer": {
    "en": "Reference information only. Prices vary by location, season, portion size, ingredients and service. This tool does not determine whether a seller acted improperly.",
    "ko": "참고 정보입니다. 가격은 지역, 시기, 양, 재료와 서비스에 따라 달라질 수 있습니다. 이 도구는 판매자의 행위가 부당했는지 판정하지 않습니다."
  },
  "higher_price_note": {
    "en": "Tourist areas, hotels and airports legitimately cost more.",
    "ko": "관광지, 호텔, 공항에서는 정상적으로 더 비쌀 수 있습니다."
  },
  "methodology": {
    "en": "Seoul dining ranges are orientation bands built around the latest Seoul average prices shown by the Korea Consumer Agency Price Information service (about ±20%, rounded). They are not observed minimum/maximum prices. Official-price items use the published standard admission fee.",
    "ko": "서울 외식 범위는 한국소비자원 참가격의 최신 서울 평균가격을 중심으로 약 ±20%를 반올림해 만든 참고 구간입니다. 실제 최저가·최고가 범위가 아닙니다. 공식가격 항목은 공개된 일반 관람요금을 사용합니다."
  },
  "flag_rule": {
    "tiers": [
      {
        "id": "within",
        "max_multiple": 1.0,
        "tone": "neutral",
        "message": {
          "en": "This is within the usual range.",
          "ko": "통상적인 가격 범위 안입니다."
        }
      },
      {
        "id": "slightly",
        "max_multiple": 1.5,
        "tone": "neutral",
        "message": {
          "en": "Slightly above the usual range. Tourist areas often cost more.",
          "ko": "통상 범위보다 조금 높습니다. 관광지에서는 더 비쌀 수 있습니다."
        }
      },
      {
        "id": "noticeably",
        "max_multiple": 2.0,
        "tone": "caution",
        "message": {
          "en": "Noticeably above the usual range.",
          "ko": "통상 범위보다 눈에 띄게 높은 편입니다."
        }
      },
      {
        "id": "well_above",
        "max_multiple": null,
        "tone": "strong",
        "message": {
          "en": "Well above the usual range for this item.",
          "ko": "이 품목의 통상 범위보다 상당히 높은 편입니다."
        }
      }
    ]
  },
