+function railCityKeyByStationName(name){
+  const raw=String(name==null?'':name).trim();
+  if(!raw) return '';
+  if(ODSAY_MOVE_POINTS[raw]) return raw;
+  const bare=raw.replace(/역$/,'');
+  for(const city in ODSAY_MOVE_POINTS){
+    const ko=String(ODSAY_MOVE_POINTS[city]?.ko||'');
+    if(ko===raw||ko.replace(/역$/,'')===bare) return city;
+  }
+  for(const city in cityMeta){
+    if(String(cityMeta[city]?.ko||'')===bare) return city;
+  }
+  return '';
+}
+function railStationLabel(rawName,fallbackCity,code){
+  const raw=String(rawName==null?'':rawName).trim();
+  if(lang==='ko') return raw||(ODSAY_MOVE_POINTS[fallbackCity]?odsayMoveLabel(fallbackCity):String(fallbackCity||''));
+  if(raw&&!/[가-힣]/.test(raw)) return raw;
+  const resolved=railCityKeyByStationName(raw)||(ODSAY_MOVE_POINTS[fallbackCity]?fallbackCity:'');
+  if(resolved) return odsayMoveLabel(resolved);
+  console.warn('[i18n:station] missing label',{nameKo:raw,code:code||null,lang});
+  if(code) return lang==='ja'?`駅 ${code}`:`Station ${code}`;
+  return lang==='ja'?'不明な駅':'Unknown station';
+}
+function formatRailDateLabel(v){
+  const s=String(v==null?'':v).trim();
+  const m=s.match(/^(\d{4})-?(\d{2})-?(\d{2})$/);
+  if(!m) return s;
+  const d=new Date(Number(m[1]),Number(m[2])-1,Number(m[3]));
+  if(Number.isNaN(d.getTime())) return s;
+  try{
+    return new Intl.DateTimeFormat(lang==='ko'?'ko-KR':lang==='ja'?'ja-JP':'en-GB',
+      {year:'numeric',month:'short',day:'numeric',weekday:'short'}).format(d);
+  }catch(_){ return `${m[1]}-${m[2]}-${m[3]}`; }
+}
